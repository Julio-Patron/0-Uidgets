# Configure secret values only in Vercel or an ignored local environment file.
# Keep sales disabled until sandbox end-to-end tests and tax setup are complete.
COMMERCE_ENABLED=false
TAX_READY=false
APP_ORIGIN=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_LIVEMODE=false
STRIPE_ACCOUNT_ID=
# For a connected sandbox, supply all ten corresponding test Price IDs as JSON.
STRIPE_PRICE_IDS_JSON=
BLOB_STORE_ID=
# Only if local tooling cannot use the connected Vercel project's OIDC credentials:
BLOB_READ_WRITE_TOKEN=
