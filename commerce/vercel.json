{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run prepare:site",
  "installCommand": "npm ci --omit=dev --ignore-scripts",
  "outputDirectory": "public",
  "regions": ["iad1"],
  "functions": { "api/*.mjs": { "maxDuration": 30 } },
  "rewrites": [
    { "source": "/checkout", "destination": "/api/checkout" },
    { "source": "/order", "destination": "/api/order" },
    { "source": "/download", "destination": "/api/download" },
    { "source": "/access", "destination": "/api/access" },
    { "source": "/restore", "destination": "/api/restore" },
    { "source": "/stripe/webhook", "destination": "/api/webhook" },
    { "source": "/purchase-privacy", "destination": "/api/purchase-privacy" },
    { "source": "/health", "destination": "/api/health" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "same-origin" }
    ] }
  ]
}
